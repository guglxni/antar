# ── LLM backends (BYOK: first one set wins) ──────────────────────────────
# neatHack shared key (default). Get it at neatlogs.com/hackathon/models
LITELLM_API_KEY=
# Point a custom OpenAI-compatible endpoint here to override (optional)
# ANTAR_BASE_URL=https://litellm.vision.aivar.app/v1

# Bring-your-own-key alternatives (take precedence over LiteLLM when set):
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...

# Model override for any backend (default: claude-haiku via LiteLLM)
# ANTAR_MODEL=claude-sonnet-4.6

# ── neatlogs (mandatory tracing) ─────────────────────────────────────────
# From your neatlogs dashboard — https://neatlogs.com
NEATLOGS_API_KEY=
NEATLOGS_WORKFLOW=antar-agent

# ── cfo.ai (mandatory business plan) ─────────────────────────────────────
# MCP server: https://api.cfo.ai/mcp  (auth via browser, see docs/setup.md)
# No API key here — OAuth through your MCP client.

# ── GitHub / GitLab (owner-scoped issues & PRs) ───────────────────────────
# Issues/PRs are opened ONLY on repos you own (GitHub: you are owner + push perm;
# GitLab: access_level >= Developer). Tokens need write scope.
# GitHub: github.com/settings/tokens  (classic: repo; fine-grained: issues+pull_requests rw)
GITHUB_TOKEN=
# GitLab (optional): gitlab.com/-/profile/personal_access_tokens (api scope)
# GITLAB_TOKEN=
# GITLAB_URL=https://gitlab.com

# ── arXiv (no key required) ───────────────────────────────────────────────
# public API, no auth.
